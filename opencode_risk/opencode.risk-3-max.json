{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "local-bridge": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local uvicorn bridge",
      "options": {
        "baseURL": "http://127.0.0.1:9010/v1",
        "apiKey": "{env:LOCAL_BRIDGE_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro via local uvicorn"
        },
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash via local uvicorn"
        },
        "gpt-5.5": {
          "id": "gpt-5.5",
          "name": "GPT-5.5 via local uvicorn"
        },
        "gpt-5.4-mini": {
          "id": "gpt-5.4-mini",
          "name": "GPT-5.4 Mini via local uvicorn"
        },
        "claude-sonnet-4-6": {
          "id": "claude-sonnet-4-6",
          "name": "Claude Sonnet 4.6 via local uvicorn"
        }
      }
    }
  },
  "model": "local-bridge/deepseek-v4-pro",
  "small_model": "local-bridge/deepseek-v4-flash",
  "default_agent": "build",
  "permission": "allow",
  "agent": {
    "build": {
      "description": "Implement changes by editing files and running verification commands.",
      "mode": "primary",
      "model": "local-bridge/gpt-5.5",
      "temperature": 0.2,
      "steps": 20,
      "permission": "allow"
    },
    "plan": {
      "description": "Read the project and create implementation plans.",
      "mode": "primary",
      "model": "local-bridge/gpt-5.5",
      "temperature": 0.1,
      "steps": 10,
      "permission": {
        "read": "allow",
        "list": "allow",
        "grep": "allow",
        "glob": "allow",
        "edit": "deny",
        "bash": "ask"
      }
    },
    "debugger": {
      "description": "Investigate errors, inspect logs, run diagnostics, and propose fixes.",
      "mode": "subagent",
      "model": "local-bridge/deepseek-v4-pro",
      "temperature": 0.1,
      "steps": 12,
      "permission": "allow"
    },
    "reviewer": {
      "description": "Review code changes for correctness, maintainability, security, and regressions.",
      "mode": "subagent",
      "model": "local-bridge/claude-sonnet-4-6",
      "temperature": 0.1,
      "steps": 10,
      "permission": {
        "read": "allow",
        "list": "allow",
        "grep": "allow",
        "glob": "allow",
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}